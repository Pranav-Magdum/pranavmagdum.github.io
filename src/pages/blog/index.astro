---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';

let posts: any[] = [];
let allTags: string[] = [];

try {
	posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
} catch {
	// Collection is empty or missing
}
---

<Layout title="Blog" description="Writing by Pranav Magdum on mathematics, study notes, and more.">
	<section class="section">
		<div class="container">
			<span class="section-kicker">Blog</span>
			<h1>All posts</h1>
			{allTags.length > 0 && (
				<div class="tag-row">
					<a class="tag" href={url('/blog/')}>all</a>
					{allTags.map((tag) => <a class="tag" href={url(`/blog/?tag=${encodeURIComponent(tag)}`)}>{tag}</a>)}
				</div>
			)}
			{posts.length > 0 ? (
				<ul class="post-list" id="post-list">
					{posts.map((post) => <PostCard post={post} />)}
				</ul>
			) : (
				<p style="color: var(--muted); margin-top: 1.5rem;">Nothing here yet.</p>
			)}
		</div>
	</section>
</Layout>

<script>
	const params = new URLSearchParams(window.location.search);
	const activeTag = params.get('tag');

	if (activeTag) {
		const tagUrl = `${import.meta.env.BASE_URL}blog/?tag=${encodeURIComponent(activeTag)}`;
		const tagLinks = document.querySelectorAll('.tag');
		tagLinks.forEach((link) => {
			if (link.getAttribute('href') === tagUrl) {
				link.style.outline = '2px solid var(--accent)';
			}
		});

		document.querySelectorAll('#post-list li').forEach((item) => {
			const itemTags = (item.getAttribute('data-tags') ?? '').split(' ');
			if (!itemTags.includes(activeTag)) {
				item.style.display = 'none';
			}
		});
	}
</script>
