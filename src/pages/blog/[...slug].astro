---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/formatDate';
import { url } from '../../lib/url';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: import('astro:content').CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={description}>
	<article>
		<header class="article-header">
			<div class="container">
				<a class="back-link" href={url('/blog/')}>← All posts</a>
				<h1>{title}</h1>
				<div class="post-meta">
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
					{updatedDate && (
						<span>
							Updated: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
						</span>
					)}
					<span>
						{tags.map((tag) => <a class="tag" href={url(`/blog/?tag=${encodeURIComponent(tag)}`)}>{tag}</a>)}
					</span>
				</div>
			</div>
		</header>
		<div class="container">
			<div class="prose">
				<Content />
			</div>
		</div>
	</article>
</Layout>
